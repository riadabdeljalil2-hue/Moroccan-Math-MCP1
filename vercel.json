{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "src/server/data/**"
    }
  },
  "headers": [
    {
      "source": "/mcp",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-transform" },
        { "key": "X-Accel-Buffering", "value": "no" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, x-api-key, x-mcp-api-key, mcp-session-id, Last-Event-ID" }
      ]
    },
    {
      "source": "/sse",
      "headers": [
        { "key": "Content-Type", "value": "text/event-stream" },
        { "key": "Cache-Control", "value": "no-cache, no-transform" },
        { "key": "Connection", "value": "keep-alive" },
        { "key": "X-Accel-Buffering", "value": "no" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/mcp", "destination": "/api/index.ts" },
    { "source": "/sse", "destination": "/api/index.ts" },
    { "source": "/messages", "destination": "/api/index.ts" },
    { "source": "/api/(.*)", "destination": "/api/index.ts" }
  ]
}
